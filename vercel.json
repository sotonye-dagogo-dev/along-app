{
  "functions": {
    "app/api/auth/register/route.ts": { "maxDuration": 30 },
    "app/api/auth/login/route.ts": { "maxDuration": 15 },
    "app/api/auth/otp/route.ts": { "maxDuration": 15 },
    "app/api/auth/otp/resend/route.ts": { "maxDuration": 30 },
    "app/api/auth/verify-email/route.ts": { "maxDuration": 30 },
    "app/api/auth/change-email/route.ts": { "maxDuration": 30 },
    "app/api/auth/change-password/route.ts": { "maxDuration": 15 },
    "app/api/auth/forgot-password/route.ts": { "maxDuration": 15 },
    "app/api/auth/reset-password/route.ts": { "maxDuration": 15 },
    "app/api/routes/trace/route.ts": { "maxDuration": 15 },
    "app/api/posts/route.ts": { "maxDuration": 15 },
    "app/api/posts/feed/route.ts": { "maxDuration": 15 },
    "app/api/upload/route.ts": { "maxDuration": 30 },
    "app/api/cron/process-deletions/route.ts": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/cron/process-deletions",
      "schedule": "0 2 * * *"
    }
  ],
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
