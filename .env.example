# Core
# PROJECT_ENV wins when set (development|staging|production); otherwise
# NODE_ENV decides. Effective env drives: DB precedence (prisma.ts),
# cookie security, dev-only logs, strict secrets — see app/lib/config/env.ts.
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_APP_VERSION=0.0.0
PROJECT_ENV=development

# Database — Supabase (primary), Prisma Postgres (legacy / offsite mirror)
#
# The ORM is still Prisma; only the Postgres instance changed. Prisma 7
# resolves FOUR datasource names, so all four must agree on the live DB
# or development silently writes to the wrong place:
#
#   production  (PROJECT_ENV=production)  -> DIRECT_URL || DATABASE_URL
#   development (PROJECT_ENV=development) -> DIRECT_LOCAL_DB || LOCAL_DB
#
# Keep every one of them pointed at SUPABASE. See the migration notes below.
#
# Supabase exposes two poolers — use the right one for the right job:
#   DATABASE_URL  port 6543  transaction mode — the app runtime (many short
#                            queries, cheap connections)
#   DIRECT_URL    port 5432  session mode     — `prisma migrate`, seeds and
#                            the DB-transfer scripts (DDL + long transactions)
DATABASE_URL=postgresql://USER:PASSWORD@PROJECT.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@PROJECT.pooler.supabase.com:5432/postgres
# Development aliases (MUST match the values above, or dev + `prisma migrate`
# keep talking to the legacy database — the transfer scripts warn about this):
LOCAL_DB=postgresql://USER:PASSWORD@PROJECT.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_LOCAL_DB=postgresql://USER:PASSWORD@PROJECT.pooler.supabase.com:5432/postgres

# Legacy Prisma Postgres — RETAINED ON PURPOSE, read-only from here on.
# Used as the migration source by `npm run db:migrate-supabase` and as the
# offsite mirror target by `npm run db:backup-supabase`.
# PREVIOUS_DATABASE_URL is an Accelerate URL (prisma+postgres://) and CANNOT
# be opened by the pg driver — scripts use PREVIOUS_DIRECT_URL instead.
PREVIOUS_DATABASE_URL=prisma://accelerate.prisma-data.net/?api_key=...
PREVIOUS_DIRECT_URL=postgresql://USER:PASSWORD@pooled.db.prisma.io:5432/along

# ── DB transfer tooling (scripts/db-*.ts) ────────────────────────────────
# All optional; sensible defaults are built in. Every value below is the
# default unless noted.
#
# Where dump files + the resume journal live (gitignored via /backups/):
#DB_BACKUP_DIR=backups/db-transfer
#DB_BACKUP_JOURNAL=backups/db-transfer/state.json
#
# How recent a completed-but-unused backup must be to be REUSED instead of
# re-dumping after an interrupted run (minutes):
#DB_BACKUP_FRESHNESS_MINUTES=120
#
# Verification depth: `full` re-reads every row and compares per-table
# content hashes; `counts` compares row counts only (cheap, weaker):
#DB_BACKUP_VERIFY_MODE=full
#
# Set to false to skip the pre-overwrite safety snapshot of a non-empty
# target. NOT recommended — a failed overwrite would be unrecoverable:
#DB_BACKUP_SAFETY_BACKUP=true
#
# One-off connection overrides (otherwise PREVIOUS_DIRECT_URL / DIRECT_URL
# are used). Handy for pointing a single run at another database:
#DB_BACKUP_LEGACY_URL=
#DB_BACKUP_SUPABASE_URL=
#
# Print full stack traces on unexpected failures:
#DB_BACKUP_DEBUG=true
#
# Commands:
#   npm run db:migrate-supabase   one-shot legacy -> Supabase cutover (resumable)
#   npm run db:backup-local       verified snapshot of either database
#   npm run db:restore-local      verified, transactional restore from a file
#   npm run db:backup-supabase    Supabase -> local file AND Prisma mirror

# Auth (JWT) — app/lib/utils/auth.ts accepts JWT_SECRET or JWT_ACCESS_SECRET; middleware aligns on same fallback
JWT_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# OAuth (Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Maps — KEYLESS BY DEFAULT (Sprint 19 stack, no keys required):
# tiles = OpenFreeMap vector (keyless) + keyless raster fallbacks;
# routing = OSRM demo via server proxy (cached) -> straight-line fallback;
# geocoding = /api/maps/* server proxy (Nominatim + Photon fallback).
# Everything below is an OPTIONAL override consulted only when set.
# Leave ALL of them unset to prove the keyless path.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY= (legacy, unused by keyless stack)
# NEXT_PUBLIC_MAPTILER_STYLE_URL= (optional override only)
# NEXT_PUBLIC_MAPBOX_TOKEN= (optional routing override only)
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN= (optional routing override only)
# NEXT_PUBLIC_CARTO_API_KEY= (optional — plain keyless Carto is the default, NO ?apiKey= sent)
# NEXT_PUBLIC_CARTO_KEY= (optional alias)
# MAPBOX_TOKEN= (optional server routing override only)
# OPEN_ROUTE_SERVICE_KEY= (optional server routing override only)
# NEXT_PUBLIC_MAPTILER_API_KEY= (optional override only)
# TOMTOM_TRAFFIC_KEY= (optional live-traffic override only — when set, route
# maps prefer TomTom flow segments; Mapbox congestion is used first when a
# Mapbox key exists; with neither key, maps show a keyless traffic estimate
# clearly labeled "estimated")


# Resend
RESEND_API_KEY=

# PWA / Push Notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:along@example.com

# Service Worker (dev)
NEXT_PUBLIC_ENABLE_SW_IN_DEV=false

# QStash workers
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Internal notifications
INTERNAL_API_SECRET=

# Account-deletion cron (Vercel cron calls POST /api/cron/process-deletions)
CRON_SECRET=

# Platform suggestions
PLATFORM_USER_EMAIL=platform@alongng.com

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
