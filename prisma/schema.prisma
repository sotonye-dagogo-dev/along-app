// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum RewardTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum BugStatus {
  OPEN
  TRIAGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum BugCategory {
  UI
  ROUTING
  AUTH
  PERFORMANCE
  DATA
  NOTIFICATIONS
  OTHER
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccountDeletionStatus {
  PENDING
  CANCELLED
  COMPLETED
}

// User Model
model User {
  id           String     @id @default(cuid())
  userName     String     @unique
  firstName    String
  lastName     String
  email        String     @unique
  password     String
  avatar       String?
  bio          String?
  location     String?
  verified     Boolean    @default(false)
  role         UserRole   @default(USER)
  rewardPoints Int        @default(0)
  rewardTier   RewardTier @default(BRONZE)
  inviteCode   String?    @unique
  invitedById  String?
  googleId     String?    @unique
  avatarConfig Json?
  lastKnownLat Float?
  lastKnownLng Float?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Safe account-deletion lifecycle (non-breaking additive).
  // PENDING = archived + grace period; COMPLETED = anonymized; CANCELLED = reversed.
  isDeleted            Boolean    @default(false)
  deletedAt            DateTime?
  deletionRequestedAt  DateTime?
  deletionScheduledFor DateTime?
  deletionReason       String?

  // Relations
  posts                Post[]
  comments             Comment[]
  likes                Like[]
  bookmarks            Bookmark[]
  notifications        NotificationRecipient[]
  notificationsAsActor Notification[]          @relation("NotificationActor")
  activities           UserActivity[]
  bugReports           BugReport[]             @relation("BugReporter")
  reviewedBugReports   BugReport[]             @relation("BugReviewer")
  authoredReviews      UserReview[]            @relation("ReviewAuthor")
  receivedReviews      UserReview[]            @relation("ReviewTarget")

  invitedBy    User?  @relation("UserInvites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedUsers User[] @relation("UserInvites")

  deletionRequests AccountDeletionRequest[]

  // Self-referential many-to-many for following
  following       Follow[]         @relation("UserFollowing")
  followers       Follow[]         @relation("UserFollowers")
  analyticsEvents AnalyticsEvent[]
  pushSubscriptions PushSubscription[]

  @@index([userName])
  @@index([email])
  @@index([role])
  @@index([rewardTier])
  @@index([invitedById])
  @@index([createdAt])
}

// Follow Model (Self-referential many-to-many)
model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@index([createdAt])
}

// Post Model
model Post {
  id              String   @id @default(cuid())
  userId          String
  title           String
  description     String?
  type            PostType @default(ROUTE)
  quotedPostId    String?
  routes          Json // Array of Route objects
  images          String[] // Array of Cloudinary URLs
  tags            String[]
  likes           Int      @default(0)
  dislikes        Int      @default(0)
  comments        Int      @default(0)
  bookmarks       Int      @default(0)
  validityScore   Int      @default(0)
  validityTier    String?
  startLat        Float?
  startLng        Float?
  endLat          Float?
  endLng          Float?
  waypoints       Json?
  region          String?
  totalDistanceKm Float?
  estimatedMins   Int?
  isPlatformGen   Boolean  @default(false)
  views           Int      @default(0)
  shares          Int      @default(0)
  // Soft-archive (non-breaking additive): archived posts are hidden from
  // feeds/explore/search but remain viewable by owner/admin and restorable.
  // Comments are not archivable (they are not standalone posts).
  isArchived      Boolean  @default(false)
  archivedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  quotedPost      Post?            @relation("PostQuote", fields: [quotedPostId], references: [id], onDelete: SetNull)
  quotes          Post[]           @relation("PostQuote")
  postComments    Comment[]
  postLikes       Like[]
  postBookmarks   Bookmark[]
  notifications   Notification[]
  userActivities  UserActivity[]
  analyticsEvents AnalyticsEvent[]
  bugReports      BugReport[]

  @@index([userId])
  @@index([type])
  @@index([quotedPostId])
  @@index([validityScore])
  @@index([validityTier])
  @@index([isPlatformGen])
  @@index([region])
  @@index([startLat, startLng])
  @@index([endLat, endLng])
  @@index([createdAt(sort: Desc)])
  @@index([tags])
  @@index([isArchived])
}

// Post type discriminator: ROUTE = normal shared route, ROUTE_REQUEST = a user
// asking the community for a route, ROUTE_RESPONSE = a route posted to satisfy
// a ROUTE_REQUEST (linked via quotedPostId).
enum PostType {
  ROUTE
  ROUTE_REQUEST
  ROUTE_RESPONSE
}

// Comment Model
model Comment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  text      String
  likes     Int      @default(0)
  dislikes  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  post          Post           @relation(fields: [postId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([postId])
  @@index([userId])
  @@index([createdAt])
}

// Like Model
model Like {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  type      LikeType
  createdAt DateTime @default(now())

  // Relations
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
  @@index([createdAt])
}

enum LikeType {
  LIKE
  DISLIKE
}

// Bookmark Model
model Bookmark {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  // Relations
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId])
  @@index([createdAt])
}

// Notification Model
model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  actorId   String // User who triggered the notification
  postId    String?
  commentId String?
  message   String
  createdAt DateTime         @default(now())

  // Relations
  actor      User                    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  post       Post?                   @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment    Comment?                @relation(fields: [commentId], references: [id], onDelete: Cascade)
  recipients NotificationRecipient[]

  @@index([actorId])
  @@index([createdAt(sort: Desc)])
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  MENTION
  WELCOME
  ROUTE_REQUEST
  ROUTE_RESPONSE
  REWARD
  BADGE
  VERIFIED
  // Moderation/report lifecycle (non-breaking additive enum values).
  // REPORT notifies admins (and confirms receipt to the reporter);
  // MODERATION notifies the reporter of the outcome. Reporter identity is
  // never exposed to the reported author (anonymity maintained server-side).
  REPORT
  MODERATION
  // Engagement coverage (non-breaking additive enum values).
  // DISLIKE notifies the author when their post is disliked (distinct from
  // LIKE so the icon/copy can differ); NEW_ROUTE fans out to followers when
  // someone they follow shares a route (ROUTE / ROUTE_RESPONSE).
  DISLIKE
  NEW_ROUTE
  // Account-deletion lifecycle (non-breaking additive enum values).
  // REQUESTED fans out to admins; CANCELLED confirms reversal to admins
  // (in-app only, no email to avoid abuse); COMPLETED confirms to the user
  // via email (in-app impossible post-anonymization).
  ACCOUNT_DELETION_REQUESTED
  ACCOUNT_DELETION_CANCELLED
  ACCOUNT_DELETION_COMPLETED
}

// NotificationRecipient Model (Many-to-many between Notification and User)
model NotificationRecipient {
  id             String   @id @default(cuid())
  notificationId String
  userId         String
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  // Relations
  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, read])
  @@index([createdAt])
}

// UserActivity Model (For feed algorithm)
model UserActivity {
  id        String       @id @default(cuid())
  userId    String
  type      ActivityType
  postId    String?
  tagId     String?
  score     Float        @default(1.0)
  createdAt DateTime     @default(now())

  // Relations
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
}

enum ActivityType {
  VIEW
  LIKE
  COMMENT
  BOOKMARK
  SHARE
}

model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model BugReport {
  id          String      @id @default(cuid())
  title       String
  description String
  category    BugCategory
  status      BugStatus   @default(OPEN)
  reporterId  String?
  reviewerId  String?
  postId      String?
  metadata    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  resolvedAt  DateTime?

  reporter User? @relation("BugReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  reviewer User? @relation("BugReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  post     Post? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([reporterId])
  @@index([reviewerId])
  @@index([status])
  @@index([category])
  @@index([createdAt(sort: Desc)])
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

model UserReview {
  id         String       @id @default(cuid())
  reviewerId String
  revieweeId String
  rating     Int
  comment    String?
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  reviewer User @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewee User @relation("ReviewTarget", fields: [revieweeId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, revieweeId])
  @@index([reviewerId])
  @@index([revieweeId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  eventName String
  userId    String?
  postId    String?
  region    String?
  payload   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  post Post? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([eventName])
  @@index([userId])
  @@index([postId])
  @@index([region])
  @@index([createdAt(sort: Desc)])
}

// EmailLog — audit trail for all sent emails
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  type      String   // "otp" | "welcome" | "contact_notification" | "bug_report_notification" | "password_reset"
  status    String   // "sent" | "failed" | "skipped" (when Resend not configured)
  error     String?
  metadata  Json?    // e.g. { otp: "...", userId: "..." }
  createdAt DateTime @default(now())

  @@index([to])
  @@index([type])
  @@index([status])
  @@index([createdAt(sort: Desc)])
}

// PasswordResetToken — durable DB store for forgot-password links.
// Replaces Redis/memory-only storage which is non-durable across serverless
// instances (token set on instance A invisible on instance B => immediate
// "link expired or invalid"). Supports multiple concurrent tokens per email.
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

// EmailOtpToken — durable DB store for email-verification OTPs (register /
// resend / verify-email trigger) and change-email confirmations.
// Same class as PasswordResetToken: Redis/memory-only `otp:{email}` is
// non-durable across serverless instances (code set on instance A invisible
// on instance B => immediate "code expired or was replaced" seconds after
// issuance). Single-active per (email, purpose[, userId]): each issuance
// replaces prior rows, so the "newest email" copy stays honest.
model EmailOtpToken {
  id        String   @id @default(cuid())
  email     String
  purpose   String
  userId    String?
  otpHash   String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose])
  @@index([userId, purpose])
  @@index([expiresAt])
}

// PushSubscription — stores Web Push API subscriptions per user/device
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([userId])
}

// AuditLog — unified who/what/when trail for admin-visible mutations
// (user verify/role changes, template saves/toggles/restores, blog ops,
// moderation, deletions). Append-only; never updated or deleted by app code.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entity])
  @@index([createdAt(sort: Desc)])
}

// AccountDeletionRequest — safe, reversible deletion lifecycle.
// Request archives the account + posts; a cron finalizes after the grace
// period by anonymizing PII and clearing personalized rows (likes/bookmarks).
// Original contact is snapshotted so the completion email can still send
// after PII is wiped, and to support off-platform backup recovery (30d).
model AccountDeletionRequest {
  id               String                @id @default(cuid())
  userId           String
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  status           AccountDeletionStatus @default(PENDING)
  reason           String?
  originalEmail    String
  originalUserName String
  requestedAt      DateTime              @default(now())
  scheduledFor     DateTime
  cancelledAt      DateTime?
  completedAt      DateTime?
  completedBy      String?
  metadata         Json?

  @@index([userId])
  @@index([status])
  @@index([scheduledFor])
  @@index([requestedAt(sort: Desc)])
}
